menu "C题 BU04 PDOA数字钥匙"

config BU04_UART_NUM
    int "BU04 UART控制器编号"
    range 1 2
    default 1
    help
        UART0保留给下载和调试日志，BU04默认使用UART1。

config BU04_UART_TX_GPIO
    int "可选：ESP32连接BU04 UART2_RX的TX GPIO（-1禁用）"
    range -1 48
    default -1
    help
        当前固件只读取BU04 UART2_TX，默认不连接反向串口。

config BU04_UART_RX_GPIO
    int "ESP32连接BU04 UART2_TX的RX GPIO"
    range 0 48
    default 18

config BU04_UART_BAUD_RATE
    int "BU04 UART2波特率"
    range 1200 2000000
    default 115200

config BU04_SIGNAL_TIMEOUT_MS
    int "无有效PDOA帧后闭锁时间(ms)"
    range 100 5000
    default 500

config BU04_ENABLE_RAW_CAPTURE
    bool "输出原始UART数据用于协议诊断"
    default n

config BU04_IDLE_FLUSH_MS
    int "原始数据空闲切帧时间(ms)"
    range 5 1000
    default 50

config BU04_FRAME_BUFFER_SIZE
    int "原始数据缓冲区大小"
    range 128 4096
    default 1024

config C_KEY_PDOA_TAG_ADDRESS
    hex "已配对BU03标签短地址"
    range 0x0000 0xFFFF
    default 0x6E19

config C_KEY_LOGICAL_TAG_ID
    int "该标签对应的四位逻辑钥匙ID"
    range 0 15
    default 0

config C_KEY_ACCEPTED_ID_DEFAULT
    int "拨码开关不可用时的门锁ID"
    range 0 15
    default 0

menu "PDOA定位标定与滤波"

config C_KEY_PDOA_DISTANCE_SCALE_PPM
    int "BU04距离比例系数(ppm)"
    range 900000 1100000
    default 1000000

config C_KEY_PDOA_DISTANCE_OFFSET_MM
    int "BU04距离偏移(mm)"
    range -1000 1000
    default 0

config C_KEY_DOOR_RADIUS_MM
    int "门锁圆柱边界半径(mm)"
    range 0 300
    default 300

config C_KEY_FRONT_OFFSET_DEG
    int "BU04安装正前方角度零偏(deg)"
    range -180 180
    default 0

config C_KEY_FILTER_ALPHA_PERCENT
    int "距离EMA滤波系数百分比"
    range 1 100
    default 35

config C_KEY_ANGLE_FILTER_STATIONARY_ALPHA_PERCENT
    int "静止角度EMA滤波系数百分比"
    range 1 100
    default 15

config C_KEY_ANGLE_FILTER_MOVING_ALPHA_PERCENT
    int "移动角度EMA滤波系数百分比"
    range 1 100
    default 60

config C_KEY_ANGLE_FILTER_MOTION_THRESHOLD_DEG
    int "角度快速跟随阈值(deg)"
    range 1 90
    default 3

endmenu

endmenu
