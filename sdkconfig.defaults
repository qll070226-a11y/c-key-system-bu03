CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_COMPILER_OPTIMIZATION_DEBUG=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BU04_UART_NUM=1
CONFIG_BU04_UART_TX_GPIO=-1
CONFIG_BU04_UART_RX_GPIO=18
CONFIG_BU04_UART_BAUD_RATE=115200
CONFIG_BU04_SIGNAL_TIMEOUT_MS=500
CONFIG_C_KEY_PDOA_TAG_ADDRESS=0x6E19
CONFIG_C_KEY_LOGICAL_TAG_ID=0
CONFIG_C_KEY_ACCEPTED_ID_DEFAULT=0
CONFIG_C_KEY_PDOA_DISTANCE_SCALE_PPM=1000000
CONFIG_C_KEY_PDOA_DISTANCE_OFFSET_MM=0
CONFIG_C_KEY_DOOR_RADIUS_MM=300
CONFIG_C_KEY_FRONT_OFFSET_DEG=0
CONFIG_C_KEY_FILTER_ALPHA_PERCENT=35
CONFIG_C_KEY_ANGLE_CAL_RAW_NEG15_TENTHS=-123
CONFIG_C_KEY_ANGLE_CAL_RAW_NEG30_TENTHS=-282
CONFIG_C_KEY_ANGLE_CAL_RAW_NEG45_TENTHS=-415
CONFIG_C_KEY_ANGLE_ONE_EURO_MIN_CUTOFF_CENTIHZ=80
CONFIG_C_KEY_ANGLE_ONE_EURO_BETA_MILLI=30
CONFIG_C_KEY_ANGLE_ONE_EURO_DERIVATIVE_CUTOFF_CENTIHZ=100
CONFIG_C_KEY_ANGLE_HAMPEL_SIGMA_TENTHS=30
CONFIG_C_KEY_ANGLE_HAMPEL_MIN_THRESHOLD_DEG=12
CONFIG_C_KEY_ANGLE_HAMPEL_MAX_REJECTIONS=3
CONFIG_C_KEY_BUZZER_ACTIVE_LOW=y
